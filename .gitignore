# ====================================================================
# .gitignore - AudioScribe
# ====================================================================

# Entornos virtuales de Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimizados
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribución y empaquetado
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Archivos temporales de subida y multimedia procesada (Manteniendo .gitkeep)
temp_uploads/*
!temp_uploads/.gitkeep

Transcripciones/*
!Transcripciones/.gitkeep

Descarga_Videos_YT/*
!Descarga_Videos_YT/.gitkeep

Descarga_audio_YT/*
!Descarga_audio_YT/.gitkeep

Convertidos_MP3/*
!Convertidos_MP3/.gitkeep

Recortes_Archivos/*
!Recortes_Archivos/.gitkeep

Fusionados_Archivos/*
!Fusionados_Archivos/.gitkeep

# Modelos descargados de Whisper / Torch Cache
.cache/
*.pt

# IDEs y Editores de código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/

# Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
